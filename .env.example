# AI Company OS -- configuration example.
#
# Copy to .env and replace every value marked CHANGE_ME before starting:
#     cp .env.example .env
#     ./scripts/generate-secrets.sh     # or fill the secrets by hand
#
# This file contains no real secrets and is safe to commit. The generated .env
# must never be committed.

# --- database -------------------------------------------------------------
POSTGRES_USER=acos
# CHANGE_ME: long random password. Only the postgres container and the API
# connection string use it; it is never sent to the browser.
POSTGRES_PASSWORD=CHANGE_ME_postgres_password
POSTGRES_DB=acos

# CHANGE_ME: must match POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB above.
# The password is URL-encoded; special characters must be percent-encoded.
DATABASE_URL=postgresql+psycopg://acos:CHANGE_ME_postgres_password@postgres:5432/acos

# --- application ----------------------------------------------------------
APP_ENV=production
APP_VERSION=0.1.0
LOG_LEVEL=INFO

# The origin the browser uses. This is the CSRF/origin allow-list anchor, so it
# must match the address in your browser exactly (scheme, host, port).
PUBLIC_BASE_URL=http://localhost:8080

# Additional accepted origins, as a JSON array (e.g. a LAN or tailnet address).
# Example: ["http://192.168.1.20:8080"]
EXTRA_ALLOWED_ORIGINS=[]

# --- sessions -------------------------------------------------------------
SESSION_TTL_HOURS=12
# Set to true when the site is served over HTTPS. Leave false only for
# plain-HTTP local use; a Secure cookie over HTTP would never be sent.
COOKIE_SECURE=false

# --- authentication policy ------------------------------------------------
PASSWORD_MIN_LENGTH=12
LOCKOUT_THRESHOLD=10
LOCKOUT_MINUTES=5

# --- web ------------------------------------------------------------------
# Publish on loopback only. Put a TLS-terminating reverse proxy in front for
# anything beyond local use.
WEB_BIND_ADDRESS=127.0.0.1
WEB_PORT=8080

# --- model providers ------------------------------------------------------
# Provider credentials are typed in the model centre and stored AES-256-GCM
# encrypted in the database (ADR-0006). This value is the *data key* used for
# that encryption: 32 random bytes, base64. Generate it with:
#   python scripts/generate_secrets.py --force   (or `openssl rand -base64 32`)
# Keep it out of database backups: without it the stored keys cannot be read,
# and after replacing it every saved provider key must be re-entered.
SECRET_ENCRYPTION_KEY=

# Legacy Phase 02 source: only used by provider rows that still reference an
# environment variable *name*. New providers do not need this. Leave empty if
# you configure every key in the UI.
DEEPSEEK_API_KEY=

# --- worker ---------------------------------------------------------------
WORKER_NAME=worker-1
WORKER_HEARTBEAT_INTERVAL_SECONDS=5

# --- development helpers --------------------------------------------------
# Exposes /api/docs. Keep false in a deployment you did not build for debugging.
ENABLE_API_DOCS=false
